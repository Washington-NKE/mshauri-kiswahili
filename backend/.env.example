PROJECT_NAME="Mshauri Kiswahili Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Local development uses SQLite. Set DATABASE_URL to your own database URL
# only when you have created and secured a database for this project.
DATABASE_URL="sqlite:///./mshauri.db"

# Optional: provide your own key to enable Gemini-backed answer synthesis.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
